# Copy to .env for local development. Real env vars win in production.

# Postgres connection string (required). Matches docker-compose's db service.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# HTTP listen address.
ADDR=:8080

# development | production. Controls the Secure flag on the session cookie.
APP_ENV=development

# Registration policy. false (default) = first-user-only: the first account
# bootstraps your single user, then registration closes. true = anyone can
# register (multi-user).
ALLOW_OPEN_REGISTRATION=false

# Web push (optional). Generate a pair with:
#   cd server && go run ./cmd/vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# MCP server (optional). cmd/mcp normally reads ~/.config/<app>.json - see the
# README. These override it, for pointing a local `go run ./cmd/mcp` at
# something other than your standing config. Left commented so a copied .env
# doesn't silently shadow that file. The URL is the app origin, not /api.
#MCP_APP_URL=http://localhost:8080
#MCP_APP_TOKEN=
